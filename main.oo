// # oohead Main Entry Point - Sovereign Prefix Line and Byte Slicer
//
// Logline: Capability-bounded prefix stream slicer with zero ambient authority.
//
// Setup: Demands FsReadCap, ProcessCap, EnvCap tokens without ambient privileges.
//
// Beats:
//   1. Dispatch early execution modes (--help, --version, --test, --demo, --mcp).
//   2. Determine header banner rules across multi-file target streams.
//   3. Ingest files under FsReadCap and extract configured prefix slices.
//   4. Emit formatted text payloads or structured JSON Lines representations.

import "core/head_types.oo";
import "core/prefix_slice.oo";
import "core/file_reader.oo";
import "render/render_header.oo";
import "render/render_json.oo";
import "render/render_demo.oo";
import "ipc/cli_options.oo";
import "ipc/mcp_server.oo";
import "anchor.oo";

pub fn main(
    fs: &FsReadCap,
    _proc_cap: &ProcessCap,
    _env: &EnvCap,
    args: List[String]
) -> Result[Int, String] {
    let opts: CliParsedOptions = parse_cli_args(args);

    if opts.show_help {
        print(render_cli_help());
        return Ok(0);
    }
    if opts.show_version {
        println("oohead 0.2.0 (openOODA sovereign prefix line & byte slicer)");
        return Ok(0);
    }
    if opts.test_mode {
        if verify_all() {
            println("OK: all tests passed");
            return Ok(0);
        }
        println("FAIL: verification error");
        return Ok(1);
    }
    if opts.demo_mode {
        print(run_head_demo(!opts.no_color));
        return Ok(0);
    }
    if opts.mcp_mode {
        run_mcp_server(fs);
        return Ok(0);
    }

    let files_cnt: Int = list_len(opts.files);
    let color: Bool = !opts.no_color;
    let render_headers: Bool = should_render_header(files_cnt, opts.quiet, opts.verbose);
    let cfg: HeadConfig = opts_to_head_config(opts);

    if files_cnt == 0 {
        let sample_stdin: String = "";
        let res: HeadResult = if cfg.is_bytes_mode {
            slice_bytes("standard input", sample_stdin, cfg.bytes_count, cfg.is_negative)
        } else {
            slice_lines("standard input", sample_stdin, cfg.lines_count, cfg.is_negative, cfg.zero_delim)
        };
        if opts.json_mode {
            println(head_result_to_json(res));
        } else {
            print(res.content);
        }
        return Ok(0);
    }

    let mut i: Int = 0;
    let mut exit_code: Int = 0;
    while i < files_cnt {
        let path: String = list_get(opts.files, i);
        let f_res: Result[HeadResult, String] = read_file_head(fs, path, cfg);
        if !f_res.is_ok() {
            let err_msg: String = match f_res { Ok(_) => "", Err(e) => e };
            println("oohead: " + err_msg);
            exit_code = 1;
        } else {
            let res: HeadResult = match f_res { Ok(r) => r, Err(_) => make_head_result(path, "", 0, 0, false) };
            if opts.json_mode {
                println(head_result_to_json(res));
            } else {
                if render_headers {
                    print(format_file_header(path, i == 0, color));
                }
                print(res.content);
            }
        }
        i = i + 1;
    }

    return Ok(exit_code);
}

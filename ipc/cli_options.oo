// # Command Line Interface Argument Parser
//
// Logline: Decodes CLI flags into structured configuration records.
//
// Setup: Parses POSIX flags for line/byte counts, quiet/verbose mode, and MCP server.
//
// Beats:
//   1. Declare CliParsedOptions container structure with flat fields.
//   2. Parse integer counts with support for negative bounds.
//   3. Ingest CLI tokens and map flags to options fields.
//   4. Format standard POSIX help usage documentation.

import "core/head_types.oo";

pub type CliParsedOptions = struct {
    lines_count: Int,
    bytes_count: Int,
    is_bytes_mode: Bool,
    is_negative: Bool,
    quiet: Bool,
    verbose: Bool,
    zero_delim: Bool,
    files: List[String],
    json_mode: Bool,
    demo_mode: Bool,
    no_color: Bool,
    test_mode: Bool,
    mcp_mode: Bool,
    show_help: Bool,
    show_version: Bool
};

pub fn parse_int_val(s: String) -> Int {
    let mut clean: String = s;
    if str_starts_with(clean, "-") {
        clean = str_slice(clean, 1, chars_len(clean));
    }
    let n: Int = chars_len(clean);
    let mut val: Int = 0;
    let mut i: Int = 0;
    while i < n {
        let ch: String = char_at(clean, i);
        let mut d: Int = -1;
        if ch == "0" { d = 0; } else if ch == "1" { d = 1; }
        else if ch == "2" { d = 2; } else if ch == "3" { d = 3; }
        else if ch == "4" { d = 4; } else if ch == "5" { d = 5; }
        else if ch == "6" { d = 6; } else if ch == "7" { d = 7; }
        else if ch == "8" { d = 8; } else if ch == "9" { d = 9; }
        if d >= 0 {
            val = (val * 10) + d;
        }
        i = i + 1;
    }
    return val;
}

pub fn default_cli_options() -> CliParsedOptions {
    return CliParsedOptions {
        lines_count: 10,
        bytes_count: 0,
        is_bytes_mode: false,
        is_negative: false,
        quiet: false,
        verbose: false,
        zero_delim: false,
        files: list_new(),
        json_mode: false,
        demo_mode: false,
        no_color: false,
        test_mode: false,
        mcp_mode: false,
        show_help: false,
        show_version: false
    };
}

pub fn opts_to_head_config(opts: CliParsedOptions) -> HeadConfig {
    return HeadConfig {
        lines_count: opts.lines_count,
        bytes_count: opts.bytes_count,
        is_bytes_mode: opts.is_bytes_mode,
        is_negative: opts.is_negative,
        quiet: opts.quiet,
        verbose: opts.verbose,
        zero_delim: opts.zero_delim
    };
}

pub fn parse_cli_args(args: List[String]) -> CliParsedOptions {
    let mut opts: CliParsedOptions = default_cli_options();
    let n: Int = list_len(args);
    let mut i: Int = 0;

    while i < n {
        let arg: String = list_get(args, i);
        if arg == "-h" || arg == "--help" {
            opts.show_help = true;
        } else if arg == "-v" || arg == "--verbose" {
            opts.verbose = true;
            opts.quiet = false;
        } else if arg == "--version" {
            opts.show_version = true;
        } else if arg == "-q" || arg == "--quiet" || arg == "--silent" {
            opts.quiet = true;
            opts.verbose = false;
        } else if arg == "-z" || arg == "--zero-terminated" {
            opts.zero_delim = true;
        } else if arg == "-j" || arg == "--json" {
            opts.json_mode = true;
        } else if arg == "-D" || arg == "--demo" {
            opts.demo_mode = true;
        } else if arg == "--no-color" {
            opts.no_color = true;
        } else if arg == "--test" {
            opts.test_mode = true;
        } else if arg == "--mcp" {
            opts.mcp_mode = true;
        } else if (arg == "-n" || arg == "--lines") && (i + 1) < n {
            i = i + 1;
            let val_str: String = list_get(args, i);
            opts.is_bytes_mode = false;
            opts.is_negative = str_starts_with(val_str, "-");
            opts.lines_count = parse_int_val(val_str);
        } else if (arg == "-c" || arg == "--bytes") && (i + 1) < n {
            i = i + 1;
            let val_str: String = list_get(args, i);
            opts.is_bytes_mode = true;
            opts.is_negative = str_starts_with(val_str, "-");
            opts.bytes_count = parse_int_val(val_str);
        } else if str_starts_with(arg, "-n") && chars_len(arg) > 2 {
            let val_str: String = str_slice(arg, 2, chars_len(arg));
            opts.is_bytes_mode = false;
            opts.is_negative = str_starts_with(val_str, "-");
            opts.lines_count = parse_int_val(val_str);
        } else if str_starts_with(arg, "-c") && chars_len(arg) > 2 {
            let val_str: String = str_slice(arg, 2, chars_len(arg));
            opts.is_bytes_mode = true;
            opts.is_negative = str_starts_with(val_str, "-");
            opts.bytes_count = parse_int_val(val_str);
        } else if !str_starts_with(arg, "-") {
            opts.files = list_push(opts.files, arg);
        }
        i = i + 1;
    }

    return opts;
}

pub fn render_cli_help() -> String {
    let mut out: String = "Usage: oohead [OPTION]... [FILE]...\n\n";
    out = out + "Print the first 10 lines of each FILE to standard output.\n";
    out = out + "With more than one FILE, precede each with a header giving the file name.\n\n";
    out = out + "Mandatory arguments to long options are mandatory for short options too.\n";
    out = out + "  -c, --bytes=[-]NUM       print the first NUM bytes of each file;\n";
    out = out + "                             with the leading '-', print all but the last NUM bytes\n";
    out = out + "  -n, --lines=[-]NUM       print the first NUM lines instead of the first 10;\n";
    out = out + "                             with the leading '-', print all but the last NUM lines\n";
    out = out + "  -q, --quiet, --silent    never print headers giving file names\n";
    out = out + "  -v, --verbose            always print headers giving file names\n";
    out = out + "  -z, --zero-terminated    line delimiter is NUL, not newline\n";
    out = out + "  -j, --json               emit structured RFC 8259 JSON Lines\n";
    out = out + "  -D, --demo               run interactive prefix slicing demonstration\n";
    out = out + "      --no-color           disable ANSI color sequences\n";
    out = out + "      --test               run automated internal self-test suite\n";
    out = out + "      --mcp                launch streaming JSON-RPC 2.0 stdio server\n";
    out = out + "  -h, --help               display this help and exit\n";
    out = out + "      --version            output version information and exit\n";
    return out;
}
